     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 1, "y2": 0}, "b": {"x1": {"$f": "-inf"}, "y1": 2, "x2": 1, "y2": 2}}},

    {"id": "ptsegdist-interior", "fn": "ptSegDist", "note": "projection inside the segment", "tags": [],
