{
  "format": "embodic.golden-cases",
  "format_version": 1,
  "area": "m1",
  "cases": [
    {"id": "primlength-line-3-4-5", "fn": "primLength", "note": "line length is the Euclidean distance (3-4-5 triangle)", "tags": ["line"],
     "inputs": {"prim": {"type": "line", "x1": 0, "y1": 0, "x2": 3, "y2": 4, "width": 0.2, "kind": "side"}}},
    {"id": "primlength-line-reversed", "fn": "primLength", "note": "line running towards -x, +y", "tags": ["line"],
     "inputs": {"prim": {"type": "line", "x1": 2.5, "y1": -1, "x2": -1.5, "y2": 2, "width": 0.3, "kind": "lead"}}},
    {"id": "primlength-line-zero", "fn": "primLength", "note": "zero-length line", "tags": ["line", "zero-length"],
     "inputs": {"prim": {"type": "line", "x1": 1.25, "y1": 1.25, "x2": 1.25, "y2": 1.25, "width": 0.2, "kind": "side"}}},
    {"id": "primlength-line-far-from-origin", "fn": "primLength", "note": "short line far from the origin (cancellation in x2 - x1)", "tags": ["line"],
     "inputs": {"prim": {"type": "line", "x1": 1000.125, "y1": -2000.5, "x2": 1003.125, "y2": -1996.5, "width": 0.2, "kind": "side"}}},
    {"id": "primlength-arc-ccw-quarter", "fn": "primLength", "note": "counter-clockwise quarter arc", "tags": ["arc", "ccw"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": 10, "a1": 0, "a2": 1.5707963267948966, "width": 0.25, "kind": "endturn"}}},
    {"id": "primlength-arc-cw-quarter", "fn": "primLength", "note": "clockwise quarter arc (a2 < a1)", "tags": ["arc", "cw"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": 10, "a1": 1.5707963267948966, "a2": 0, "width": 0.25, "kind": "endturn"}}},
    {"id": "primlength-arc-ccw-270", "fn": "primLength", "note": "counter-clockwise 270 degree arc off the origin", "tags": ["arc", "ccw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": 1.5, "cy": -2, "r": 5, "a1": 0.7853981633974483, "a2": 5.497787143782138, "width": 0.2, "kind": "bus"}}},
    {"id": "primlength-arc-cw-300", "fn": "primLength", "note": "clockwise 300 degree arc", "tags": ["arc", "cw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": -3, "cy": 4, "r": 2.5, "a1": 5.235987755982989, "a2": 0, "width": 0.2, "kind": "bus"}}},
    {"id": "primlength-arc-full-circle", "fn": "primLength", "note": "full circle from -pi to pi", "tags": ["arc", "ccw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": 7, "a1": -3.141592653589793, "a2": 3.141592653589793, "width": 0.2, "kind": "ring"}}},
    {"id": "primlength-arc-zero-sweep", "fn": "primLength", "note": "arc with a1 == a2", "tags": ["arc", "zero-length"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": 4, "a1": 1.2, "a2": 1.2, "width": 0.2, "kind": "fillet"}}},
    {"id": "primlength-arc-zero-radius", "fn": "primLength", "note": "arc with r == 0 (sharp corner fillet)", "tags": ["arc", "zero-length"],
     "inputs": {"prim": {"type": "arc", "cx": 2, "cy": 2, "r": 0, "a1": 0, "a2": 3.141592653589793, "width": 0.2, "kind": "fillet"}}},
    {"id": "primlength-arc-unnormalised", "fn": "primLength", "note": "clockwise sweep larger than 2 pi with angles outside [0, 2 pi)", "tags": ["arc", "cw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": 3, "a1": 7.5, "a2": -2.0, "width": 0.2, "kind": "bus"}}},
    {"id": "primlength-arc-r-inf", "fn": "primLength", "note": "infinite radius propagates to an infinite length", "tags": ["arc", "nonfinite-input"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": {"$f": "inf"}, "a1": 0, "a2": 1, "width": 0.2, "kind": "bus"}}},

    {"id": "primslength-chain-line-arc-line", "fn": "primsLength", "note": "left-to-right sum over a line, a quarter arc and a line", "tags": ["line", "arc", "ccw"],
     "inputs": {"prims": [
       {"type": "line", "x1": 10, "y1": 0, "x2": 20, "y2": 0, "width": 0.2, "kind": "side"},
       {"type": "arc", "cx": 20, "cy": 5, "r": 5, "a1": -1.5707963267948966, "a2": 0, "width": 0.2, "kind": "fillet"},
       {"type": "line", "x1": 25, "y1": 5, "x2": 25, "y2": 15, "width": 0.2, "kind": "side"}]}},
    {"id": "primslength-empty", "fn": "primsLength", "note": "empty chain has length 0", "tags": ["zero-length"],
     "inputs": {"prims": []}},
    {"id": "primslength-with-zero-length", "fn": "primsLength", "note": "zero-length members contribute nothing", "tags": ["line", "arc", "cw", "zero-length"],
     "inputs": {"prims": [
       {"type": "line", "x1": 1, "y1": 1, "x2": 1, "y2": 1, "width": 0.2, "kind": "side"},
       {"type": "arc", "cx": 1, "cy": 0, "r": 1, "a1": 1.5707963267948966, "a2": -1.0, "width": 0.2, "kind": "endturn"},
       {"type": "line", "x1": 3, "y1": 3, "x2": 3, "y2": 3, "width": 0.2, "kind": "side"}]}},

    {"id": "primstart-line", "fn": "primStart", "note": "line start is (x1, y1)", "tags": ["line"],
     "inputs": {"prim": {"type": "line", "x1": -2.25, "y1": 3.5, "x2": 4, "y2": -1, "width": 0.2, "kind": "side"}}},
    {"id": "primend-line", "fn": "primEnd", "note": "line end is (x2, y2)", "tags": ["line"],
     "inputs": {"prim": {"type": "line", "x1": -2.25, "y1": 3.5, "x2": 4, "y2": -1, "width": 0.2, "kind": "side"}}},
    {"id": "primstart-arc-ccw", "fn": "primStart", "note": "arc start at angle a1", "tags": ["arc", "ccw"],
     "inputs": {"prim": {"type": "arc", "cx": 2, "cy": -1, "r": 3, "a1": 1.0471975511965976, "a2": 4.1887902047863905, "width": 0.2, "kind": "endturn"}}},
    {"id": "primend-arc-ccw", "fn": "primEnd", "note": "arc end at angle a2", "tags": ["arc", "ccw"],
     "inputs": {"prim": {"type": "arc", "cx": 2, "cy": -1, "r": 3, "a1": 1.0471975511965976, "a2": 4.1887902047863905, "width": 0.2, "kind": "endturn"}}},
    {"id": "primstart-arc-cw-gt180", "fn": "primStart", "note": "clockwise 240 degree arc start", "tags": ["arc", "cw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": -1, "cy": 1, "r": 4, "a1": 0.5235987755982988, "a2": -3.6651914291880917, "width": 0.2, "kind": "bus"}}},
    {"id": "primend-arc-cw-gt180", "fn": "primEnd", "note": "clockwise 240 degree arc end", "tags": ["arc", "cw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": -1, "cy": 1, "r": 4, "a1": 0.5235987755982988, "a2": -3.6651914291880917, "width": 0.2, "kind": "bus"}}},
    {"id": "primend-arc-unnormalised", "fn": "primEnd", "note": "end angle 9 rad, start -8 rad", "tags": ["arc", "ccw", "gt180"],
     "inputs": {"prim": {"type": "arc", "cx": 0.5, "cy": 0.5, "r": 1.5, "a1": -8.0, "a2": 9.0, "width": 0.2, "kind": "bus"}}},
    {"id": "primstart-line-signed-zero", "fn": "primStart", "note": "negative zero coordinates survive the dump", "tags": ["line", "signed-zero"],
     "inputs": {"prim": {"type": "line", "x1": -0.0, "y1": -0.0, "x2": 1, "y2": 1, "width": 0.2, "kind": "side"}}},
    {"id": "primstart-arc-r-inf", "fn": "primStart", "note": "infinite radius at a1 = 0 gives [Infinity, NaN] (Infinity * sin 0)", "tags": ["arc", "nonfinite-input"],
     "inputs": {"prim": {"type": "arc", "cx": 0, "cy": 0, "r": {"$f": "inf"}, "a1": 0, "a2": 1, "width": 0.2, "kind": "bus"}}},

    {"id": "reverseprims-line", "fn": "reversePrims", "note": "reversed line swaps its endpoints", "tags": ["line"],
     "inputs": {"prims": [{"type": "line", "x1": 1, "y1": 2, "x2": 5, "y2": -3, "width": 0.35, "kind": "lead"}]}},
    {"id": "reverseprims-arc-ccw", "fn": "reversePrims", "note": "reversed counter-clockwise arc runs clockwise", "tags": ["arc", "ccw"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 12, "a1": 0.2, "a2": 1.4, "width": 0.25, "kind": "endturn"}]}},
    {"id": "reverseprims-chain-mixed", "fn": "reversePrims", "note": "chain order reverses and every member flips direction", "tags": ["line", "arc", "cw", "gt180"],
     "inputs": {"prims": [
       {"type": "line", "x1": 0, "y1": 0, "x2": 4, "y2": 0, "width": 0.2, "kind": "side"},
       {"type": "arc", "cx": 4, "cy": 2, "r": 2, "a1": -1.5707963267948966, "a2": -5.497787143782138, "width": 0.15, "kind": "fillet"},
       {"type": "line", "x1": 5.414213562373095, "y1": 3.414213562373095, "x2": 8, "y2": 6, "width": 0.2, "kind": "side"}]}},
    {"id": "reverseprims-empty", "fn": "reversePrims", "note": "empty chain stays empty", "tags": ["zero-length"],
     "inputs": {"prims": []}},

    {"id": "tfpoint-rotation", "fn": "tfPoint", "note": "rotation by 30 degrees", "tags": ["rotation"],
     "inputs": {"tf": {"rot": 0.5235987755982988, "mirror": false}, "thetaG": 0, "x": 3, "y": 4}},
    {"id": "tfpoint-mirror", "fn": "tfPoint", "note": "mirror about the axis at thetaG = 0.3 rad", "tags": ["mirror"],
     "inputs": {"tf": {"rot": 0, "mirror": true}, "thetaG": 0.3, "x": 3, "y": 4}},
    {"id": "tfpoint-mirror-rotation", "fn": "tfPoint", "note": "mirror, then rotate by -2 rad", "tags": ["mirror", "rotation"],
     "inputs": {"tf": {"rot": -2.0, "mirror": true}, "thetaG": 1.1, "x": -2.5, "y": 7}},
    {"id": "tfpoint-origin", "fn": "tfPoint", "note": "origin maps to the origin (atan2(0, 0) = 0)", "tags": ["mirror", "rotation", "degenerate"],
     "inputs": {"tf": {"rot": 1, "mirror": true}, "thetaG": 0.4, "x": 0, "y": 0}},
    {"id": "tfpoint-negative-x-axis", "fn": "tfPoint", "note": "point on the negative x axis (atan2 = +pi)", "tags": ["rotation"],
     "inputs": {"tf": {"rot": 0.25, "mirror": false}, "thetaG": 0, "x": -5, "y": 0}},
    {"id": "tfpoint-negative-x-signed-zero", "fn": "tfPoint", "note": "y = -0 on the negative x axis gives atan2 = -pi", "tags": ["signed-zero"],
     "inputs": {"tf": {"rot": 0, "mirror": false}, "thetaG": 0, "x": -5, "y": -0.0}},

    {"id": "tfprim-line-rotation", "fn": "tfPrim", "note": "line rotated by 90 degrees", "tags": ["line", "rotation"],
     "inputs": {"tf": {"rot": 1.5707963267948966, "mirror": false}, "thetaG": 0, "prim": {"type": "line", "x1": 10, "y1": 0, "x2": 20, "y2": 0, "width": 0.2, "kind": "side"}}},
    {"id": "tfprim-line-mirror", "fn": "tfPrim", "note": "line mirrored about the 30 degree axis", "tags": ["line", "mirror"],
     "inputs": {"tf": {"rot": 0, "mirror": true}, "thetaG": 0.5235987755982988, "prim": {"type": "line", "x1": 10, "y1": 1, "x2": 20, "y2": -1, "width": 0.2, "kind": "side"}}},
    {"id": "tfprim-arc-origin-rotation", "fn": "tfPrim", "note": "origin-centred arc keeps cx = cy = 0 and shifts its angles", "tags": ["arc", "ccw", "rotation"],
     "inputs": {"tf": {"rot": 1.0471975511965976, "mirror": false}, "thetaG": 0, "prim": {"type": "arc", "cx": 0, "cy": 0, "r": 15, "a1": 0.1, "a2": 0.6, "width": 0.2, "kind": "endturn"}}},
    {"id": "tfprim-arc-origin-mirror", "fn": "tfPrim", "note": "mirroring flips the sweep direction", "tags": ["arc", "ccw", "mirror"],
     "inputs": {"tf": {"rot": 0, "mirror": true}, "thetaG": 0.35, "prim": {"type": "arc", "cx": 0, "cy": 0, "r": 15, "a1": 0.1, "a2": 0.6, "width": 0.2, "kind": "endturn"}}},
    {"id": "tfprim-arc-offset-mirror-rotation-gt180", "fn": "tfPrim", "note": "off-centre 229 degree arc, mirrored and rotated", "tags": ["arc", "ccw", "gt180", "mirror", "rotation"],
     "inputs": {"tf": {"rot": -0.7, "mirror": true}, "thetaG": 0.2, "prim": {"type": "arc", "cx": 12, "cy": -3, "r": 2, "a1": 1, "a2": 5, "width": 0.15, "kind": "fillet"}}},
    {"id": "tfprim-arc-cw-rotation", "fn": "tfPrim", "note": "clockwise off-centre arc rotated by 2 rad", "tags": ["arc", "cw", "rotation"],
     "inputs": {"tf": {"rot": 2.0, "mirror": false}, "thetaG": 0, "prim": {"type": "arc", "cx": 8, "cy": 8, "r": 1.25, "a1": 2.5, "a2": 0.5, "width": 0.2, "kind": "fillet"}}},

    {"id": "discretize-line-defaults", "fn": "discretize", "note": "10 mm line with the default step parameters (hMax 0.5 mm)", "tags": ["line", "default-params"],
     "inputs": {"prims": [{"type": "line", "x1": 0, "y1": 0, "x2": 10, "y2": 0, "width": 0.2, "kind": "side"}]}},
    {"id": "discretize-line-hmax-0p1", "fn": "discretize", "note": "2.5 mm line, hMax 0.1 mm", "tags": ["line"],
     "inputs": {"prims": [{"type": "line", "x1": 0, "y1": 0, "x2": 1.5, "y2": 2, "width": 0.2, "kind": "side"}], "hMax": 0.1}},
    {"id": "discretize-line-hmax-2", "fn": "discretize", "note": "diagonal line, hMax 2 mm", "tags": ["line"],
     "inputs": {"prims": [{"type": "line", "x1": -3, "y1": -3, "x2": 4, "y2": 5, "width": 0.2, "kind": "side"}], "hMax": 2}},
    {"id": "discretize-line-shorter-than-hmax", "fn": "discretize", "note": "line shorter than hMax gives one segment", "tags": ["line"],
     "inputs": {"prims": [{"type": "line", "x1": 0, "y1": 0, "x2": 0.18, "y2": 0.24, "width": 0.2, "kind": "lead"}], "hMax": 0.5}},
    {"id": "discretize-line-exact-multiple", "fn": "discretize", "note": "L / hMax is exactly 4 (ceil threshold)", "tags": ["line", "threshold"],
     "inputs": {"prims": [{"type": "line", "x1": 0, "y1": 0, "x2": 1, "y2": 0, "width": 0.2, "kind": "side"}], "hMax": 0.25}},
    {"id": "discretize-chain-skips-zero-length", "fn": "discretize", "note": "zero-length member is skipped; pi keeps the original index", "tags": ["line", "zero-length"],
     "inputs": {"prims": [
       {"type": "line", "x1": 0, "y1": 0, "x2": 1, "y2": 0, "width": 0.2, "kind": "side"},
       {"type": "line", "x1": 1, "y1": 0, "x2": 1, "y2": 0, "width": 0.2, "kind": "taper"},
       {"type": "line", "x1": 1, "y1": 0, "x2": 1, "y2": 1, "width": 0.3, "kind": "side"}], "hMax": 0.5}},
    {"id": "discretize-arc-ccw-quarter-defaults", "fn": "discretize", "note": "r 10 counter-clockwise quarter arc, default step parameters", "tags": ["arc", "ccw", "default-params"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 10, "a1": 0, "a2": 1.5707963267948966, "width": 0.25, "kind": "endturn"}]}},
    {"id": "discretize-arc-cw-quarter-defaults", "fn": "discretize", "note": "r 10 clockwise quarter arc, default step parameters", "tags": ["arc", "cw", "default-params"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 10, "a1": 1.5707963267948966, "a2": 0, "width": 0.25, "kind": "endturn"}]}},
    {"id": "discretize-arc-ccw-270-hmax-2", "fn": "discretize", "note": "270 degree arc, hMax 2 mm (sagitta-limited count)", "tags": ["arc", "ccw", "gt180"],
     "inputs": {"prims": [{"type": "arc", "cx": 1, "cy": 1, "r": 5, "a1": 0.25, "a2": 4.96238898038469, "width": 0.2, "kind": "bus"}], "hMax": 2}},
    {"id": "discretize-arc-cw-300-dang-2deg", "fn": "discretize", "note": "clockwise 300 degree arc, dAngMax 2 degrees, sagTol 0.01 mm (angle-limited count)", "tags": ["arc", "cw", "gt180"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 1, "a1": 5.235987755982989, "a2": 0, "width": 0.2, "kind": "bus"}], "dAngMax": 0.03490658503988659, "sagTol": 0.01}},
    {"id": "discretize-arc-radius-below-sagtol", "fn": "discretize", "note": "r below sagTol uses dAngMax instead of the sagitta angle", "tags": ["arc", "ccw", "threshold"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 0.0005, "a1": 0, "a2": 3.141592653589793, "width": 0.2, "kind": "fillet"}]}},
    {"id": "discretize-arc-sagtol-tight", "fn": "discretize", "note": "r 20 arc with sagTol 0.0001 mm (sagitta-limited count)", "tags": ["arc", "ccw"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 20, "a1": 0, "a2": 0.5, "width": 0.2, "kind": "endturn"}], "sagTol": 0.0001}},
    {"id": "discretize-arc-sagtol-loose", "fn": "discretize", "note": "r 20 arc with sagTol 0.01 mm (hMax-limited count)", "tags": ["arc", "ccw"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 20, "a1": 0, "a2": 0.5, "width": 0.2, "kind": "endturn"}], "hMax": 0.5, "sagTol": 0.01}},
    {"id": "discretize-chain-mixed-hmax-0p3", "fn": "discretize", "note": "line, fillet arc, line; s runs along the whole chain", "tags": ["line", "arc", "ccw"],
     "inputs": {"prims": [
       {"type": "line", "x1": 10, "y1": 0, "x2": 12, "y2": 0, "width": 0.2, "kind": "side"},
       {"type": "arc", "cx": 12, "cy": 0.5, "r": 0.5, "a1": -1.5707963267948966, "a2": 0, "width": 0.18, "kind": "fillet"},
       {"type": "line", "x1": 12.5, "y1": 0.5, "x2": 12.5, "y2": 3, "width": 0.2, "kind": "side"}], "hMax": 0.3}},
    {"id": "discretize-hmax-zero-uses-default", "fn": "discretize", "note": "hMax 0 is falsy in JS, so the 0.5 mm default applies", "tags": ["line", "default-params"],
     "inputs": {"prims": [{"type": "line", "x1": 0, "y1": 0, "x2": 2, "y2": 0, "width": 0.2, "kind": "side"}], "hMax": 0}},
    {"id": "discretize-arc-large-radius-hmax-0p1", "fn": "discretize", "note": "r 40 short arc, hMax 0.1 mm", "tags": ["arc", "ccw"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 40, "a1": 1.0, "a2": 1.05, "width": 0.2, "kind": "endturn"}], "hMax": 0.1}},
    {"id": "discretize-empty", "fn": "discretize", "note": "empty chain gives no segments", "tags": ["zero-length"],
     "inputs": {"prims": []}},
    {"id": "discretize-arc-zero-sweep-skipped", "fn": "discretize", "note": "zero-sweep arc is skipped, the following line keeps pi 1", "tags": ["arc", "line", "zero-length"],
     "inputs": {"prims": [
       {"type": "arc", "cx": 0, "cy": 0, "r": 3, "a1": 1, "a2": 1, "width": 0.2, "kind": "fillet"},
       {"type": "line", "x1": 0, "y1": 0, "x2": 0.5, "y2": 0, "width": 0.2, "kind": "side"}]}},
    {"id": "discretize-arc-full-circle-all-params", "fn": "discretize", "note": "full circle with hMax 2 mm, dAngMax 10 degrees, sagTol 0.005 mm", "tags": ["arc", "ccw", "gt180"],
     "inputs": {"prims": [{"type": "arc", "cx": 0, "cy": 0, "r": 2, "a1": 0, "a2": 6.283185307179586, "width": 0.2, "kind": "ring"}], "hMax": 2, "dAngMax": 0.17453292519943295, "sagTol": 0.005}},

    {"id": "segsegdist-parallel-disjoint", "fn": "segSegDist", "note": "parallel segments 1 mm apart", "tags": ["parallel"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 10, "y2": 0}, "b": {"x1": 0, "y1": 1, "x2": 10, "y2": 1}}},
    {"id": "segsegdist-crossing", "fn": "segSegDist", "note": "X crossing gives 0", "tags": ["crossing"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 4, "y2": 4}, "b": {"x1": 0, "y1": 4, "x2": 4, "y2": 0}}},
    {"id": "segsegdist-t-junction", "fn": "segSegDist", "note": "b starts on the interior of a", "tags": ["touching"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 4, "y2": 0}, "b": {"x1": 2, "y1": 0, "x2": 2, "y2": 3}}},
    {"id": "segsegdist-endpoint-touch", "fn": "segSegDist", "note": "segments share an endpoint", "tags": ["touching"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 1, "y2": 1}, "b": {"x1": 1, "y1": 1, "x2": 2, "y2": 0}}},
    {"id": "segsegdist-collinear-overlap", "fn": "segSegDist", "note": "collinear overlap (den = 0) falls back to endpoint distances", "tags": ["collinear"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 4, "y2": 0}, "b": {"x1": 2, "y1": 0, "x2": 6, "y2": 0}}},
    {"id": "segsegdist-collinear-gap", "fn": "segSegDist", "note": "collinear segments with a 2 mm gap", "tags": ["collinear"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 1, "y2": 0}, "b": {"x1": 3, "y1": 0, "x2": 5, "y2": 0}}},
    {"id": "segsegdist-near-parallel-below-den-threshold", "fn": "segSegDist", "note": "|den| about 1.1e-16 is below the 1e-15 intersection threshold", "tags": ["parallel", "threshold"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 1, "y2": 0}, "b": {"x1": 0, "y1": 0.5, "x2": 1, "y2": 0.5000000000000001}}},
    {"id": "segsegdist-shallow-crossing-above-den-threshold", "fn": "segSegDist", "note": "shallow crossing with den 2e-11 takes the intersection branch", "tags": ["crossing", "threshold"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 10, "y2": 0}, "b": {"x1": 0, "y1": -1e-12, "x2": 10, "y2": 1e-12}}},
    {"id": "segsegdist-point-vs-segment", "fn": "segSegDist", "note": "a is a single point", "tags": ["degenerate"],
     "inputs": {"a": {"x1": 1, "y1": 1, "x2": 1, "y2": 1}, "b": {"x1": 0, "y1": 0, "x2": 2, "y2": 0}}},
    {"id": "segsegdist-two-points", "fn": "segSegDist", "note": "both segments are points", "tags": ["degenerate"],
     "inputs": {"a": {"x1": 0, "y1": 0, "x2": 0, "y2": 0}, "b": {"x1": 3, "y1": 4, "x2": 3, "y2": 4}}},
    {"id": "segsegdist-perpendicular-apart", "fn": "segSegDist", "note": "perpendicular, not crossing; endpoint is closest", "tags": ["perpendicular"],
